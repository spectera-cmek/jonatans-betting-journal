# Database — Postgres (Neon). Prisma CLI and the migration scripts read THIS file.
# Copy to .env and fill in the connection strings from Vercel → Storage → Postgres.
#
# DATABASE_URL = the POOLED connection string (has `-pooler` in the host) — used by the
#                app at runtime. DIRECT_URL = the DIRECT string — used by `prisma db push`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
