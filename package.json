{
  "name": "betting-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first sports betting journal — log bets in units, track ROI and bankroll over time, and auto-settle from a bet365 statement or The Odds API. Next.js + Prisma/SQLite.",
  "license": "MIT",
  "author": "Jonatan",
  "keywords": [
    "betting",
    "betting-tracker",
    "sports-betting",
    "bankroll",
    "roi",
    "nextjs",
    "prisma",
    "sqlite",
    "typescript"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectera-cmek/jonatans-betting-journal.git"
  },
  "homepage": "https://github.com/spectera-cmek/jonatans-betting-journal#readme",
  "bugs": {
    "url": "https://github.com/spectera-cmek/jonatans-betting-journal/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:export": "tsx scripts/exportData.ts",
    "db:import": "tsx scripts/importData.ts",
    "icons": "tsx scripts/makeIcons.ts",
    "sync": "tsx scripts/sync.ts",
    "import:bet365": "tsx scripts/importBet365.ts",
    "import:unibet": "tsx scripts/importUnibet.ts",
    "recategorize": "tsx scripts/recategorize.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^16.4.5",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "pdfjs-dist": "^4.0.379",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
