{
  "name": "betting-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A personal sports betting journal — log bets in units, track ROI, CLV and bankroll over time, and auto-settle from a bet365 statement or The Odds API. Next.js + Prisma/Postgres, deployable to Vercel as a PWA.",
  "license": "MIT",
  "author": "Jonatan",
  "keywords": [
    "betting",
    "betting-tracker",
    "sports-betting",
    "bankroll",
    "roi",
    "nextjs",
    "prisma",
    "postgres",
    "clv",
    "typescript"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectera-cmek/jonatans-betting-journal.git"
  },
  "homepage": "https://github.com/spectera-cmek/jonatans-betting-journal#readme",
  "bugs": {
    "url": "https://github.com/spectera-cmek/jonatans-betting-journal/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate && next build",
    "postinstall": "npm run generate",
    "generate": "prisma generate && prisma generate --schema prisma/cs2.prisma",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:push:cs2": "prisma db push --schema prisma/cs2.prisma",
    "db:migrate-users": "tsx scripts/migrateToMultiUser.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:export": "tsx scripts/exportData.ts",
    "db:import": "tsx scripts/importData.ts",
    "icons": "tsx scripts/makeIcons.ts",
    "sync": "tsx scripts/sync.ts",
    "scrape:clv": "tsx scripts/scrapeClv.ts",
    "clv:coverage": "tsx scripts/clvCoverage.ts",
    "clv:suspicious": "tsx scripts/clvSuspicious.ts",
    "import:bet365": "tsx scripts/importBet365.ts",
    "import:unibet": "tsx scripts/importUnibet.ts",
    "recategorize": "tsx scripts/recategorize.ts",
    "recategorize:detail": "tsx scripts/recategorizeDetail.ts",
    "backfill:tags": "tsx scripts/backfillBetTags.ts",
    "backfill:bookmakers": "tsx scripts/backfillBookmakers.ts",
    "agent:log": "tsx scripts/agent/logBetHttp.ts",
    "backfill:vm-refs": "tsx scripts/backfillWorldCupRefs.ts",
    "backfill:clv-scrape": "tsx scripts/scrapeClv.ts --confirm --since-days 90",
    "cs2:ingest": "tsx scripts/cs2/ingest.ts",
    "cs2:demos": "tsx scripts/cs2/demos.ts",
    "cs2:demos:batch": "tsx scripts/cs2/demos.ts --confirm --max-hours 3 --max-gb 10",
    "cs2:update": "tsx scripts/cs2/update.ts",
    "cs2:lines": "tsx scripts/cs2/update.ts --only-lines",
    "cs2:backtest": "tsx scripts/cs2/backtest.ts",
    "cs2:capture": "tsx scripts/cs2/capture.ts",
    "scrapling:setup": "tsx scripts/scrapling/setup.ts",
    "scrapling:check": "tsx scripts/scrapling/check.ts",
    "sofascore:capture": "tsx scripts/sofascore/capture.ts",
    "props:grade": "tsx scripts/results/gradeProps.ts",
    "purge:thestatsapi": "tsx scripts/purgeTheStatsApi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.27.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "10.4.20",
    "cheerio": "^1.2.0",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^9.0.3",
    "patchright": "^1.63.0",
    "pdfjs-dist": "^4.0.379",
    "postcss": "^8.5.26",
    "prisma": "5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.15",
    "tsx": "^4.23.12",
    "typescript": "5.6.3",
    "vitest": "^4.1.11",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "@laihoe/demoparser2": "^0.42.0"
  }
}
