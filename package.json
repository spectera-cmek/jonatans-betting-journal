{
  "name": "betting-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A personal sports betting journal — log bets in units, track ROI, CLV and bankroll over time, and auto-settle from a bet365 statement or The Odds API. Next.js + Prisma/Postgres, deployable to Vercel as a PWA.",
  "license": "MIT",
  "author": "Jonatan",
  "keywords": [
    "betting",
    "betting-tracker",
    "sports-betting",
    "bankroll",
    "roi",
    "nextjs",
    "prisma",
    "postgres",
    "clv",
    "typescript"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectera-cmek/jonatans-betting-journal.git"
  },
  "homepage": "https://github.com/spectera-cmek/jonatans-betting-journal#readme",
  "bugs": {
    "url": "https://github.com/spectera-cmek/jonatans-betting-journal/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate && next build",
    "postinstall": "npm run generate",
    "generate": "prisma generate && prisma generate --schema prisma/shots.prisma",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:push:shots": "prisma db push --schema prisma/shots.prisma",
    "db:migrate-users": "tsx scripts/migrateToMultiUser.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:export": "tsx scripts/exportData.ts",
    "db:import": "tsx scripts/importData.ts",
    "icons": "tsx scripts/makeIcons.ts",
    "sync": "tsx scripts/sync.ts",
    "scrape:clv": "tsx scripts/scrapeClv.ts",
    "capture:kickoff-clv": "tsx scripts/captureKickoffClv.ts",
    "watch:kickoff-clv": "tsx scripts/watchKickoffClv.ts",
    "install:kickoff-clv-task": "powershell -ExecutionPolicy Bypass -File scripts/install-kickoff-clv-task.ps1",
    "import:bet365": "tsx scripts/importBet365.ts",
    "import:unibet": "tsx scripts/importUnibet.ts",
    "recategorize": "tsx scripts/recategorize.ts",
    "recategorize:detail": "tsx scripts/recategorizeDetail.ts",
    "backfill:tags": "tsx scripts/backfillBetTags.ts",
    "backfill:vm-refs": "tsx scripts/backfillWorldCupRefs.ts",
    "backfill:clv": "tsx scripts/backfillClv.ts",
    "shots:ingest": "tsx scripts/shots/ingestMatches.ts",
    "shots:odds": "tsx scripts/shots/ingestOdds.ts",
    "shots:backtest": "tsx scripts/shots/backtest.ts",
    "shots:tune": "tsx scripts/shots/tune.ts",
    "backfill:clv-scrape": "tsx scripts/scrapeClv.ts --confirm --since-days 90"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.27.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^4.0.379",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "prisma": "5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.15",
    "tsx": "^4.23.12",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  }
}
