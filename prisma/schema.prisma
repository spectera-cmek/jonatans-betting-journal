// Betting Tracker — Prisma schema (Postgres / Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) — used by the app at runtime on serverless.
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma db push` / migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // stored lowercase; capitalized only for display
  passwordHash String // bcrypt
  createdAt    DateTime @default(now())
  bets         Bet[]
  setting      Setting?
}

model Bet {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  placedAt        DateTime        @default(now())
  eventAt         DateTime?
  sportKey        String? // The Odds API key, e.g. "soccer_epl"
  sport           String? // display name
  league          String?
  event           String // "Team A vs Team B"
  homeTeam        String?
  awayTeam        String?
  market          String          @default("h2h") // h2h | totals | spreads | other (avräkningstyp -> grading)
  marketCategory  String? // semantisk marknad, t.ex. "Skott på mål", "Returer", "Hörnor"
  marketScope     String? // player | team | match (vem/vad spelet avser)
  eventKind       String          @default("match") // match | outright
  tournamentStage String? // group | round_of_32 | round_of_16 | quarterfinal | semifinal | third_place | final
  selection       String // label, e.g. "Team A", "Over 2.5"
  selectionSide   String? // home | away | draw | over | under (structured -> grading)
  line            Float? // for totals/spreads
  betType         String          @default("single") // single | accumulator
  odds            Float // decimal odds you took
  closingOdds     Float? // for CLV
  // Odds-boost: a boosted price is not a market price, so it must never count as
  // CLV. This column has existed in the production database since before it was
  // modelled here — every `prisma db push` silently dropped it until this line.
  boosted         Boolean         @default(false)
  stakeUnits      Float // e.g. 1.0, 2.5
  outcome         String          @default("pending") // pending|win|loss|push|half_win|half_loss|void
  profitUnits     Float? // computed at settlement
  externalRef     String? // The Odds API event id (for auto-grading)
  resultProvider  String? // score provider, e.g. "espn"
  resultEventRef  String? // provider event id, separate from The Odds API externalRef
  importRef       String? // Bet365 betslip reference — stable key for incremental re-import
  legs            String? // JSON-encoded accumulator legs
  bookmaker       String?
  tipster         String?
  notes           String?
  gradedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  settlements     BetSettlement[]

  @@index([userId, outcome])
  @@index([userId, eventAt])
  // The bets list and CSV export sort by placedAt; without this Postgres seq-scans
  // the table and sorts (measured: Seq Scan over 10k rows).
  @@index([userId, placedAt])
  // The grading queue filters userId + outcome="pending" and sorts by eventAt;
  // [userId, outcome] covers the filter but leaves the sort uncovered.
  @@index([userId, outcome, eventAt])
  @@index([userId, league])
  @@index([resultProvider, resultEventRef])
  // Index (not unique): historical imports may hold duplicate refs per user.
  @@index([userId, importRef])
}

model BetSettlement {
  id              String    @id @default(cuid())
  betId           String
  bet             Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  fromOutcome     String
  toOutcome       String
  fromProfitUnits Float?
  toProfitUnits   Float?
  fromGradedAt    DateTime?
  toGradedAt      DateTime?
  source          String // manual | agent | espn | odds_api | bet365 | unibet
  reason          String?
  createdAt       DateTime  @default(now())
  revertedAt      DateTime?

  @@index([betId, createdAt])
}

model Setting {
  id                     Int    @id @default(autoincrement())
  // One settings row per user.
  userId                 String @unique
  user                   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitValue              Float  @default(100) // currency per unit
  currency               String @default("kr")
  startingBankrollUnits  Float  @default(100)
  // Tilt-guard stake budgets in units. Null/0 = budget off.
  dailyStakeBudgetUnits  Float?
  weeklyStakeBudgetUnits Float?
}

model SyncLog {
  id      String   @id @default(cuid())
  ranAt   DateTime @default(now())
  kind    String // grade | closing
  summary String
}
