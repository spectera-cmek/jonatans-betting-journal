// Betting Tracker — Prisma schema (Postgres / Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) — used by the app at runtime on serverless.
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma db push` / migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // stored lowercase; capitalized only for display
  passwordHash String // bcrypt
  createdAt    DateTime @default(now())
  bets         Bet[]
  setting      Setting?
}

model Bet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  placedAt      DateTime  @default(now())
  eventAt       DateTime?
  sportKey      String? // The Odds API key, e.g. "soccer_epl"
  sport         String? // display name
  league        String?
  event         String // "Team A vs Team B"
  homeTeam      String?
  awayTeam      String?
  market        String    @default("h2h") // h2h | totals | spreads | other
  selection     String // label, e.g. "Team A", "Over 2.5"
  selectionSide String? // home | away | draw | over | under (structured -> grading)
  line          Float? // for totals/spreads
  betType       String    @default("single") // single | accumulator
  odds          Float // decimal odds you took
  closingOdds   Float? // for CLV
  stakeUnits    Float // e.g. 1.0, 2.5
  outcome       String    @default("pending") // pending|win|loss|push|half_win|half_loss|void
  profitUnits   Float? // computed at settlement
  externalRef   String? // The Odds API event id (for auto-grading)
  importRef     String? // Bet365 betslip reference — stable key for incremental re-import
  legs          String? // JSON-encoded accumulator legs
  bookmaker     String?
  tipster       String?
  notes         String?
  gradedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, outcome])
  @@index([userId, eventAt])
  // Index (not unique): historical imports may hold duplicate refs per user.
  @@index([userId, importRef])
}

model Setting {
  id                    Int     @id @default(autoincrement())
  // One settings row per user.
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitValue             Float   @default(100) // currency per unit
  currency              String  @default("kr")
  startingBankrollUnits Float   @default(100)
  // Tilt-guard stake budgets in units. Null/0 = budget off.
  dailyStakeBudgetUnits  Float?
  weeklyStakeBudgetUnits Float?
}

model SyncLog {
  id      String   @id @default(cuid())
  ranAt   DateTime @default(now())
  kind    String // grade | closing
  summary String
}
