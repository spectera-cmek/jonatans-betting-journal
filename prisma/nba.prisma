// NBA-databasen — egen databas, skild från bet-loggen, skottmodellen och CS2.
//
// Referensdata och modellens utdata: lag, spelare, matcher, boxscores per
// spelare, ESPN:s skadelista, dina minut-ändringar, odds och projektioner.
// Källor: ESPN:s öppna JSON (resultat, boxscores, skador, DraftKings-linjer)
// och OddsPapi (Pinnacle m.fl.). Allt läses in lokalt med npm run nba:*.
//
// Generera:  npm run generate
// Migrera:   npm run db:push:nba
//
// OBS: kör aldrig db:push:nba mot samma databas som DATABASE_URL,
// SHOTS_DATABASE_URL eller CS2_DATABASE_URL utan eget schema — `db push`
// tar bort tabeller som inte finns i schemat. Samma Neon-endpoint går bra
// med ett eget Postgres-schema: `…&schema=nba`.
generator nbaClient {
  provider = "prisma-client-js"
  // Egen output — annars skriver den över huvudschemats klient.
  output   = "../node_modules/.prisma/nba-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("NBA_DATABASE_URL")
  directUrl = env("NBA_DATABASE_URL_UNPOOLED")
}

/// Ett lag. Id är ESPN:s team-id.
model NbaTeam {
  id         Int     @id
  abbr       String
  name       String
  /// OddsPapi:s participantId — lärs in första gången laget syns där.
  oddspapiId Int?    @unique
  updatedAt  DateTime @updatedAt
}

/// En spelare. Id är ESPN:s athlete-id. teamId = laget i senaste matchen.
model NbaPlayer {
  id        Int      @id
  name      String
  /// G | F | C — förenklad position för modellens priors.
  position  String?
  teamId    Int?
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

/// En match. Id är ESPN:s event-id.
model NbaGame {
  id                Int       @id
  /// ESPN:s säsongsår: 2027 = säsongen 2026–27.
  season            Int
  /// 1 = försäsong, 2 = grundserie, 3 = slutspel, 5 = play-in.
  seasonType        Int
  startAt           DateTime
  homeTeamId        Int
  awayTeamId        Int
  neutral           Boolean   @default(false)
  /// scheduled | live | final | postponed | canceled
  status            String
  homeScore         Int?
  awayScore         Int?
  /// 4 = ordinarie tid, 5+ = förlängning.
  periods           Int?
  /// När boxscoren lästes in. null = inte hämtad än.
  boxFetchedAt      DateTime?
  oddspapiFixtureId String?   @unique
  /// true = OddsPapi:s participant1 är hemmalaget (för att vända historiska odds).
  oddspapiP1Home    Boolean?
  /// När matchen senast söktes i OddsPapi:s fixtures (så att en miss inte kostar anrop igen).
  oddspapiLinkTried DateTime?
  /// När OddsPapi-historiken visade sig tom för matchen (så att den inte frågas igen).
  oddsHistoryEmptyAt DateTime?
  /// Smarkets event-id, när matchen hittats där.
  smarketsEventId   String?
  /// Stintar ur play-by-play: true = sparade, false = klarade inte kvalitetskontrollen,
  /// null = inte försökt (kör npm run nba:ingest -- --stints).
  stintsValid       Boolean?
  updatedAt         DateTime  @updatedAt

  teamGames   NbaTeamGame[]
  playerGames NbaPlayerGame[]
  odds        NbaOdds[]
  projections NbaProjection[]
  overrides   NbaMinutesOverride[]
  picks       NbaPick[]
  propLines   NbaPropLine[]
  stints      NbaStint[]
  starters    NbaStarter[]
  propProjs   NbaPropProjection[]
  smarkets    NbaSmarketsQuote[]

  @@index([startAt])
  @@index([status, startAt])
  @@index([smarketsEventId])
}

/// Lagets boxscore i en match — underlag för tempo och försvar.
model NbaTeamGame {
  gameId  Int
  game    NbaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId  Int
  home    Boolean
  pts     Int
  fgm2    Int
  fga2    Int
  fgm3    Int
  fga3    Int
  ftm     Int
  fta     Int
  oreb    Int
  dreb    Int
  /// Totala turnovers inklusive lag-turnovers.
  tov     Int

  @@id([gameId, teamId])
  @@index([teamId])
}

/// En spelares rad i boxscoren.
model NbaPlayerGame {
  gameId    Int
  game      NbaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  Int
  teamId    Int
  starter   Boolean @default(false)
  minutes   Float
  pts       Int     @default(0)
  fgm2      Int     @default(0)
  fga2      Int     @default(0)
  fgm3      Int     @default(0)
  fga3      Int     @default(0)
  ftm       Int     @default(0)
  fta       Int     @default(0)
  oreb      Int     @default(0)
  dreb      Int     @default(0)
  ast       Int     @default(0)
  tov       Int     @default(0)
  /// true = stod i boxscoren men spelade inte.
  dnp       Boolean @default(false)
  /// ESPN:s skäl, t.ex. "COACH'S DECISION" eller "INJURY/ILLNESS - ...".
  dnpReason String?

  @@id([gameId, playerId])
  @@index([playerId])
  @@index([teamId])
}

/// ESPN:s skadelista just nu. Ersätts i sin helhet vid varje körning.
model NbaInjury {
  playerId   Int      @id
  teamId     Int?
  playerName String
  /// Out | Doubtful | Questionable | Day-To-Day | Probable
  status     String
  detail     String?
  reportedAt DateTime?
  fetchedAt  DateTime @default(now())
}

/// Din egen ändring av en spelares minuter i en match. 0 = spelar inte.
model NbaMinutesOverride {
  gameId    Int
  game      NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  Int
  minutes   Float
  createdBy String?
  updatedAt DateTime @updatedAt

  @@id([gameId, playerId])
}

/// Ett pris för en marknad. Sida 1 = hemma/över, sida 2 = borta/under.
/// line: spread i hemmalagets perspektiv (−5,5 = hemma favorit), total för
/// totals, null för moneyline.
model NbaOdds {
  id         Int      @id @default(autoincrement())
  gameId     Int
  game       NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  book       String
  /// ml | spread | total
  market     String
  line       Float?
  price1     Float
  price2     Float
  /// oddspapi | oddspapi-history | oddspapi-bet[-Nh] | smarkets | espn | manual
  source     String
  capturedAt DateTime @default(now())
  /// Senaste priset före matchstart.
  isClosing  Boolean  @default(false)

  @@index([gameId, market, book, capturedAt])
}

/// Modellens pris för en match och marknad (senaste körningen).
model NbaProjection {
  id           Int      @id @default(autoincrement())
  gameId       Int
  game         NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// ml | spread | total
  market       String
  line         Float?
  /// P(sida 1 | ingen push) ur simuleringen.
  pModel       Float
  pPush        Float    @default(0)
  pMarket      Float?
  pFinal       Float
  blendW       Float
  fair1        Float
  fair2        Float
  book         String?
  price1       Float?
  price2       Float?
  edge1        Float?
  edge2        Float?
  homeMean     Float
  awayMean     Float
  marginSd     Float
  totalSd      Float
  sims         Int
  modelVersion String
  /// 1 = sida 1 vann, 0 = sida 2, 0,5 = push. Sätts när matchen är klar.
  actual       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([gameId, market])
  @@index([modelVersion, createdAt])
}

/// Modellens pick i poäng, låst mot första linjen den såg och aldrig
/// omprissatt. Facit och CLV räknas mot den låsta linjen.
model NbaPick {
  id           Int      @id @default(autoincrement())
  gameId       Int
  game         NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// spread | total
  market       String
  lockedAt     DateTime @default(now())
  book         String
  /// Spread: hemmalagets handicap. Total: totalen.
  line         Float
  price1       Float
  price2       Float
  /// Modellens linje när picken låstes (samma perspektiv som line).
  modelLine    Float
  /// 1 = hemma/över, 2 = borta/under.
  side         Int
  edgePts      Float
  modelVersion String
  /// Samma boks senaste linje före start.
  closingLine  Float?
  closingPrice Float?
  /// Poäng bättre än stängningen (positivt = marknaden gick mot oss).
  clv          Float?
  /// W | L | P
  result       String?
  homeScore    Int?
  awayScore    Int?

  @@unique([gameId, market])
  @@index([result])
}

/// En stint: samma tio spelare på planen. Underlag för spelarnas påverkan
/// (on/off, RAPM). Byggs ur ESPN:s play-by-play i lib/nba/stints.ts.
model NbaStint {
  id       Int     @id @default(autoincrement())
  gameId   Int
  game     NbaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  homeIds  Int[]
  awayIds  Int[]
  homePts  Int
  awayPts  Int
  poss     Float
  seconds  Float

  @@index([gameId])
}

/// Spelarnas påverkan (RAPM) — räknas av nba:update, läses av övriga körningar och appen.
model NbaPlayerImpact {
  playerId  Int      @id
  /// Poäng per 100 possessions laget gör mer med spelaren på planen.
  off       Float
  /// Poäng per 100 possessions motståndarna gör mindre.
  def       Float
  poss      Float
  updatedAt DateTime @updatedAt
}

/// Kvällens startfemma, när ESPN publicerat den (ungefär 30 min före start).
model NbaStarter {
  gameId    Int
  game      NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  Int
  teamId    Int
  fetchedAt DateTime @default(now())

  @@id([gameId, playerId])
  @@index([gameId, teamId])
}

/// Ett prop-pris: spelare, statistik, linje och över/under hos en bok.
model NbaPropLine {
  id         Int      @id @default(autoincrement())
  gameId     Int
  game       NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId   Int
  /// pts | reb | ast | fg3 | pra
  stat       String
  book       String
  line       Float
  over       Float
  under      Float
  /// oddspapi | manual
  source     String
  capturedAt DateTime @default(now())

  @@index([gameId, playerId, stat])
}

/// Modellens projektion för en spelare och statistik (senaste körningen),
/// prissatt mot bästa linjen om det finns en.
model NbaPropProjection {
  id           Int      @id @default(autoincrement())
  gameId       Int
  game         NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId     Int
  teamId       Int
  stat         String
  minutes      Float
  mean         Float
  median       Float
  q10          Float
  q90          Float
  line         Float?
  book         String?
  over         Float?
  under        Float?
  pModel       Float?
  pPush        Float?
  pMarket      Float?
  pFinal       Float?
  edgeOver     Float?
  edgeUnder    Float?
  modelVersion String
  /// Utfallet när matchen är spelad.
  actual       Float?
  updatedAt    DateTime @updatedAt

  @@unique([gameId, playerId, stat])
  @@index([stat, actual])
}

/// Smarkets hela stege (alla linjer) vid en tidpunkt. Sparas bara när något
/// ändrats sedan förra ögonblicksbilden. Priser i decimalodds före provision.
/// Sida 1 = hemma/över. line: hemmalagets handicap, totalen, null för vinnare.
model NbaSmarketsQuote {
  id         Int      @id @default(autoincrement())
  gameId     Int
  game       NbaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// ml | spread | total
  market     String
  line       Float?
  back1      Float?
  back2      Float?
  lay1       Float?
  lay2       Float?
  capturedAt DateTime @default(now())

  @@index([gameId, market, capturedAt])
}

/// En sparad backtest-körning (npm run nba:backtest -- --save).
model NbaBacktestRun {
  id           Int      @id @default(autoincrement())
  modelVersion String
  fromDate     DateTime
  toDate       DateTime
  games        Int
  params       Json
  metrics      Json
  createdAt    DateTime @default(now())
}
