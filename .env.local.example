# App secrets — Next.js reads THIS file at runtime. Copy to .env.local (local dev) and
# set the same values in Vercel → Project → Settings → Environment Variables (production).

# Password to open the app (single user). Pick something only you know.
APP_PASSWORD="change-me"

# Secret used to sign the login session cookie. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generate-a-long-random-string"

# Optional — The Odds API key for auto-grading + closing odds (CLV).
# Free key (~500 requests/month): https://the-odds-api.com/
# ODDS_API_KEY=your_key_here
