# App secrets ÔÇö Next.js reads THIS file at runtime. Copy to .env.local (local dev) and
# set the same values in Vercel ÔåÆ Project ÔåÆ Settings ÔåÆ Environment Variables (production).

# Secret used to sign session tokens (HMAC). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it logs everyone out.
AUTH_SECRET="generate-a-long-random-string"

# Invite code required to register a new account. Share it with people you
# want on the app; rotate it to stop new sign-ups.
INVITE_CODE="pick-an-invite-code"

# Optional — The Odds API key.  https://the-odds-api.com/
# Powers event search, auto-grading and CLV (closing odds).
#
# Krediter: 1 per region OCH marknad för vanliga odds, 10 för historiska.
# CLV-hämtningen använder historiken (regions=eu, bara marknaden spelet behöver):
# 1 kredit för matchlistan + 10 per match. Ca 3–5 tusen krediter i månaden vid
# normal spelvolym — väl inom 20K-planen.
# Se vad kvoten står på:  npm run clv:coverage
# ODDS_API_KEY=your_key_here

# Optional — delad hemlighet för /api/cron/clv.
# Vercel Cron skickar den som "Authorization: Bearer ...". Sätt samma värde i
# Vercels projektinställningar; utan den kräver endpointen en inloggad session.
# CRON_SECRET=slumpmässig_lång_sträng

# Optional ÔÇö TheStatsAPI key for closing odds / CLV on football bets.
# Historical odds (opening + last seen per bookmaker), works retroactively.
# Also powers the shot model (/skott): team stats + shot/corner odds.
# https://thestatsapi.com/
# THESTATSAPI_KEY=fapi_your_key_here

# Optional ÔÇö separate database for the shot model (/skott). Kept apart from the
# bet journal on purpose: it holds bulk-reloaded reference data (matches, odds,
# model projections) that must never be able to touch your bets.
# Create a second Neon database and connect it in Vercel with Custom Prefix
# "SHOTS" ÔÇö the integration then creates both names below automatically.
# Locally, paste them into .env.local and run:
#   npm run db:push:shots
# The endpoint MUST differ from DATABASE_URL above; same endpoint = same
# database as your bets, which defeats the point of the split.
# SHOTS_DATABASE_URL="postgresql://...@ep-xxx-pooler.../neondb?sslmode=require"
# SHOTS_DATABASE_URL_UNPOOLED="postgresql://...@ep-xxx.../neondb?sslmode=require"
