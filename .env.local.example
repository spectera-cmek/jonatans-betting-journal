# App secrets — Next.js reads THIS file at runtime. Copy to .env.local (local dev) and
# set the same values in Vercel → Project → Settings → Environment Variables (production).

# Secret used to sign session tokens (HMAC). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it logs everyone out.
AUTH_SECRET="generate-a-long-random-string"

# Invite code required to register a new account. Share it with people you
# want on the app; rotate it to stop new sign-ups.
INVITE_CODE="pick-an-invite-code"

# Optional — The Odds API key for auto-grading + closing odds (CLV).
# Free key (~500 requests/month): https://the-odds-api.com/
# ODDS_API_KEY=your_key_here
